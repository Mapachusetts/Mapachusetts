{"id":"toolu_bdrk_01A1TK3X7F8xDVVNancE7aGU-call","timestamp":"2026-10-24T20:26:51.965Z","payload":{"type":"tool_call","toolCallId":"toolu_bdrk_01A1TK3X7F8xDVVNancE7aGU","toolName":"fs_write","args":{"path":"c:\\Users\\jarba\\OneDrive\\Desktop\\Hackachusetts\\Mapachusetts\\app\\politicians\\[slug]\\CitedText.tsx","text":"import type { ReactNode } from \"react\";\n\n/**\n * Parse text containing inline [n] markers into React nodes, turning markers\n * whose number is in `validNumbers` into superscript links to #cite-n.\n * Unknown markers are left as plain text. Pure; keys are position-based.\n */\nexport function parseCitedText(\n  text: string,\n  validNumbers: ReadonlySet<number>,\n  keyPrefix = \"\"\n): ReactNode[] {\n  const nodes: ReactNode[] = [];\n  const re = /\\[(\\d+)\\]/g;\n  let last = 0;\n  let match: RegExpExecArray | null;\n\n  while ((match = re.exec(text)) !== null) {\n    const n = Number(match[1]);\n    if (!validNumbers.has(n)) continue; // leave as plain text\n\n    if (match.index > last) {\n      nodes.push(text.slice(last, match.index));\n    }\n    nodes.push(\n      <sup key={`${keyPrefix}ref-${match.index}`}>\n        <a href={`#cite-${n}`} className=\"cite-ref\" aria-label={`Source ${n}`}>\n          [{n}]\n        </a>\n      </sup>\n    );\n    last = match.index + match[0].length;\n  }\n\n  if (last < text.length) nodes.push(text.slice(last));\n  return nodes;\n}\n\n/** Render a summary (paragraphs separated by blank lines) with citation links. */\nexport default function CitedText({\n  text,\n  validNumbers,\n}: {\n  text: string;\n  validNumbers: ReadonlySet<number>;\n}) {\n  const paragraphs = text\n    .split(/\\n\\s*\\n/)\n    .map((p) => p.trim())\n    .filter(Boolean);\n\n  return (\n    <div className=\"news-summary\">\n      {paragraphs.map((p, i) => (\n        <p key={`p-${i}`}>{parseCitedText(p, validNumbers, `p${i}-`)}</p>\n      ))}\n    </div>\n  );\n}\n"},"status":"approved","kind":"edit","executionId":"b04c2126-59c7-4c68-b0b7-e3be3a838803","turnId":"b04c2126-59c7-4c68-b0b7-e3be3a838803","actionType":"create","title":"Write File","_meta":{"kiro":{"agentMode":"vibe","agentSubtaskId":"b5ab2244-1790-4fbe-9e6e-87f02b541766","toolOrigin":"default","resources":[{"provider":"github","owner":"Mapachusetts","name":"Mapachusetts"}]}},"filePath":"c:\\Users\\jarba\\OneDrive\\Desktop\\Hackachusetts\\Mapachusetts\\app\\politicians\\[slug]\\CitedText.tsx","subExecutionId":"b5ab2244-1790-4fbe-9e6e-87f02b541766"}}
